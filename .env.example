PORT=3000
AWS_REGION=us-east-1
S3_BUCKET=instabox-fotos

# Secret de Secrets Manager con los datos de la conexión a RDS
DB_SECRET_ID=instabox/rds

# Respaldo por si se crea el secret a mano y solo tiene username y password
# DB_HOST=instabox.xxxxxxxx.us-east-1.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=instabox

# Ponerlo en false solo para probar contra un Postgres local sin SSL
# DB_SSL=true
