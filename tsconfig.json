{
    "compilerOptions": {
        "noImplicitAny": true,
        "target": "es2022",
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["./src/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
